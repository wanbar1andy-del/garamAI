$ErrorActionPreference = "Stop"

# Configuration
$SCRIPT_DIR = Split-Path -Parent $MyInvocation.MyCommand.Path
$ROOT_DIR = (Resolve-Path "$SCRIPT_DIR/../..").Path
$VENV32_PATH = Join-Path $ROOT_DIR ".venv32"
$INGESTER_SCRIPT = Join-Path $ROOT_DIR "scripts/ops/ingest_kiwoom_realtime.py"

Write-Host "=== Kiwoom Ingester Launcher (v1.0) ===" -ForegroundColor Cyan
Write-Host "Root Dir: $ROOT_DIR"
Write-Host "Venv32: $VENV32_PATH"

# 1. Check for 32-bit Virtual Environment
if (-not (Test-Path $VENV32_PATH)) {
    Write-Host "[ERROR] .venv32 not found. 32-bit Python is required for Kiwoom OCX." -ForegroundColor Red
    Write-Host "Please create it: py -3.9-32 -m venv .venv32"
    Pause
    Exit 1
}

$PY32 = Join-Path $VENV32_PATH "Scripts/python.exe"

# 2. Verify Architecture
Write-Host "[Check] Verifying Python Architecture..."
try {
    & $PY32 -c "import platform; import sys; arch=platform.architecture()[0]; print(f'Detected: {arch}'); sys.exit(0 if arch=='32bit' else 1)"
}
catch {
    Write-Host "[ERROR] Python in .venv32 is NOT 32-bit!" -ForegroundColor Red
    Pause
    Exit 1
}

# 3. Launch Ingester
Write-Host "[Start] Launching Ingester..." -ForegroundColor Green
Write-Host "Cmd: $PY32 $INGESTER_SCRIPT"

try {
    & $PY32 $INGESTER_SCRIPT
}
catch {
    Write-Host "[CRASH] Ingester process exited with error." -ForegroundColor Red
    Write-Host $_
}

Write-Host "Ingester Stopped."
Pause
